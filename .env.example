# Auth.js — generate with: npx auth secret
AUTH_SECRET=
# Google Cloud OAuth client (Web application). Redirect URI: <SITE_URL>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Google Picker (browser-exposed). API key restricted to the Picker API + your domain,
# and the Cloud project NUMBER (not ID) used as the Picker app ID.
NEXT_PUBLIC_GOOGLE_API_KEY=
NEXT_PUBLIC_GOOGLE_APP_ID=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Project Settings → JWT Keys → Legacy JWT secret. Used to mint short-lived tokens so the
# lobby can subscribe to Realtime under row-level security.
SUPABASE_JWT_SECRET=

# Optional: fallback Discord webhook for people who haven't set their own ping channel
DISCORD_WEBHOOK_URL=
# Optional: "Connect Discord" button (Discord Developer Portal → OAuth2). Redirect URL:
# <NEXT_PUBLIC_SITE_URL>/api/discord/callback. Scope used: identify.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Public URL of the site (used in invite links and Discord messages)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shown in the Privacy Policy and Terms. Fill these in before launch.
NEXT_PUBLIC_OPERATOR_NAME=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_GOVERNING_STATE=
