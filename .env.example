# Auth.js — generate with: npx auth secret
AUTH_SECRET=
# Google Cloud OAuth client (Web application). Redirect URI: <SITE_URL>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Google Picker (browser-exposed). API key restricted to the Picker API + your domain,
# and the Cloud project NUMBER (not ID) used as the Picker app ID.
NEXT_PUBLIC_GOOGLE_API_KEY=
NEXT_PUBLIC_GOOGLE_APP_ID=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Project Settings → JWT Keys → Legacy JWT secret. Used to mint short-lived tokens so the
# lobby can subscribe to Realtime under row-level security.
SUPABASE_JWT_SECRET=

# Optional: group Discord webhook for unlock pings
DISCORD_WEBHOOK_URL=

# Public URL of the site (used in invite links and Discord messages)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Anti-cheat: "flag" shows "pasted?" to friends; "discount" also stops pasted words from counting
PASTE_MODE=flag
